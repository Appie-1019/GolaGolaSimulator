  m_Script: {fileID: 11500000, guid: dc007dd15369a7248ac9d43eee715c6e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SwitchBoxDescription
  switchBox: {fileID: 31522578}
  description:
  - "\uD3EC\uC778\uD130 \uC704\uCE58\uB85C \uBAB8\uD1B5\uC774 \uC774\uB3D9\uD569\uB2C8\uB2E4."
  - "\uD3EC\uC778\uD130 \uC704\uCE58\uB85C \uBAB8\uD1B5\uC774 \uBE68\uB824\uB4E4\uC5B4\uAC00\uB4EF
    \uC6C0\uC9C1\uC785\uB2C8\uB2E4. "
  - "\uD3EC\uC778\uD130 \uC704\uCE58\uB85C \uBAB8\uD1B5\uC774 \uBD80\uB4DC\uB7FD\uAC8C
    \uC774\uB3D9\uD569\uB2C8\uB2E4."
  - "\uBAB8\uD1B5\uC774 \uD68C\uC804\uD569\uB2C8\uB2E4."
  - "\uBAB8\uD1B5 \uB300\uC2E0 \uD314, \uB2E4\uB9AC\uB97C \uC870\uC791\uD569\uB2C8\uB2E4."
  - "\uADF8\uAC00 \uC18D\uB3C4\uB97C \uBAA8\uC73C\uACE0 \uC788\uC2B5\uB2C8\uB2E4!"
  - "\uD3EC\uC778\uD130 \uC8FC\uBCC0 \uB79C\uB364\uD55C \uACF5\uAC04\uC73C\uB85C
    \uC8FC\uAE30\uC801\uC73C\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4."
  - "\uBAA8\uB4E0 \uBD80\uBD84\uC774 \uACE0\uC815\uB41C \uCC44\uB85C \uD3EC\uC778\uD130\uB97C
    \uB530\uB77C\uC635\uB2C8\uB2E4."
  - "\uD314, \uB2E4\uB9AC\uAC00 \uBAB8\uD1B5\uC744 \uAE30\uC900\uC73C\uB85C \uBD80\uB4DC\uB7FD\uAC8C
    \uC774\uB3D9\uD569\uB2C8\uB2E4. "
  - "\uBA54\uBAA8\uB9AC\uAC00 \uBD80\uC871\uD560 \uC815\uB3C4\uB85C \uACE0\uAE09
    \uC6C0\uC9C1\uC784\uC744 \uC2DC\uB3C4\uD569\uB2C8\uB2E4."
  - "\uD3EC\uC778\uD130\uAC00 \uC0C1\uD638\uC791\uC6A9\uD55C \uC704\uCE58\uB85C \uBE60\uB974\uAC8C
    \uB0A0\uC544\uAC11\uB2C8\uB2E4."
  - "\uBAB8\uD1B5\uC5D0 \uC794\uC0C1\uC774 \uC0DD\uAE41\uB2C8\uB2E4."

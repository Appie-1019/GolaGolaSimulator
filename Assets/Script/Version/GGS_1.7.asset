  versionName: V1.7 (2026/9.22)
  developerComment: "\uC2A4\uD0A8 \uBC14\uAFB8\uB294 \uAE30\uB2A5 \uC5B8\uC81C\uB098\uC640\uC5EC?
    \u314B\u314B"
  additional:
  - item: "Minecraft \uB2C9\uB124\uC784\uC73C\uB85C \uC2A4\uD0A8\uC744 \uBD88\uB7EC\uC624\uB294
      \uAE30\uB2A5\uC744 \uCD94\uAC00\uD588\uC2B5\uB2C8\uB2E4."
    subItems: []
  - item: "\uD1A0\uAE00 \uC2A4\uC704\uCE58\uAC00 \uB2E4\uB978 \uD1A0\uAE00 \uC2A4\uC704\uCE58\uC5D0
      \uC885\uC18D\uB41C \uAC83\uC744 UI\uC5D0 \uC2DC\uAC01\uC801\uC73C\uB85C \uD45C\uC2DC\uD588\uC2B5\uB2C8\uB2E4."
    subItems: []
  - item: "\uC5EC\uB7EC \uC0C8\uB85C\uC6B4 \uC870\uC791 \uBC29\uC2DD\uC744 \uCD94\uAC00\uD588\uC2B5\uB2C8\uB2E4.
      \uBAA9\uB85D\uC740 \uB2E4\uC74C\uACFC \uAC19\uC2B5\uB2C8\uB2E4."
    subItems:
    - item: "\uD314\uB9CC"
      subItems: []
    - item: "\uB2E4\uB9AC\uB9CC"
      subItems: []
    - item: "\uC790\uB3D9"
      subItems: []
    - item: "\uC790\uB3D9 \uBD84\uB178"
      subItems: []
  changes:
  - item: "\uB370\uC774\uD130\uB97C \uBD88\uB7EC\uC62C \uB54C \uD1A0\uAE00 \uC2A4\uC704\uCE58
      \uC885\uC18D\uC744 \uBB34\uC2DC\uD558\uB358 \uBB38\uC81C\uB97C \uD574\uACB0\uD588\uC2B5\uB2C8\uB2E4."
    subItems:
    - item: "\uC774\uC81C \uD1A0\uAE00 \uC2A4\uC704\uCE58\uAC00 \uC885\uC18D\uC73C\uB85C
        \uAEBC\uC9C8 \uB54C \uC9C0\uC5F0 \uC2DC\uAC04\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
      subItems: []
  - item: "\uC774\uC81C \uB9C8\uC6B0\uC2A4\uB97C \uC228\uAE30\uB824\uBA74 M\uD0A4\uB97C
      0.478723\uCD08\uB3D9\uC548 \uB204\uB974\uACE0 \uC788\uC5B4\uC57C \uD569\uB2C8\uB2E4. "
    subItems: []
  - item: "\uC77C\uBD80 UI \uBA54\uC2DC\uC9C0\uAC00 \uBCC0\uACBD\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    subItems:
    - item: "\"\uD1A0\uC2A4\uD2B8 \uBA54\uC2DC\uC9C0 \uAEBC\uC9D0\" \uD1A0\uAE00
        \uC2A4\uC704\uCE58 \uBA54\uC2DC\uC9C0\uB294 \uC774\uC81C \"\uD1A0\uC2A4\uD2B8
        \uC54C\uB78C \uAEBC\uC9D0\"\uC73C\uB85C \uD45C\uC2DC\uB429\uB2C8\uB2E4."
      subItems: []
    - item: "\"\uD1A0\uC2A4\uD2B8 \uBA54\uC2DC\uC9C0 \uCF1C\uC9D0\" \uD1A0\uAE00
        \uC2A4\uC704\uCE58 \uBA54\uC2DC\uC9C0\uB294 \uC774\uC81C \"\uD1A0\uC2A4\uD2B8
        \uC54C\uB78C \uCF1C\uC9D0\"\uC73C\uB85C \uD45C\uC2DC\uB429\uB2C8\uB2E4."
      subItems: []
    - item: "\uD29C\uD1A0\uB9AC\uC5BC \uBA54\uC2DC\uC9C0 \"\uB20C\uB7EC\uC11C \uB9C8\uC6B0\uC2A4
        \uC228\uAE30\uAE30 \uD1A0\uAE00\" \uC740 \uC774\uC81C \"\uC720\uC9C0\uD574\uC11C
        \uB9C8\uC6B0\uC2A4 \uC228\uAE30\uAE30 \uD1A0\uAE00\"\uC73C\uB85C \uD45C\uC2DC\uB429\uB2C8\uB2E4."
      subItems: []
  - item: "'\uC794\uC0C1' \uC870\uC791 \uBC29\uC2DD\uC758 \uC794\uC0C1\uC774 \uC774\uC81C
      \uD604\uC7AC \uC2A4\uD0A8\uC73C\uB85C \uBAA8\uC2B5\uC774 \uBC14\uB01D\uB2C8\uB2E4."
    subItems: []
  - item: "'\uC794\uC0C1' \uC870\uC791 \uBC29\uC2DD\uC758 \uC794\uC0C1\uC740 \uC774\uC81C
      \uB450 \uBC30\uC758 \uD504\uB808\uC784 \uBCF4\uAC04\uC744 \uAC00\uC9D1\uB2C8\uB2E4."
    subItems:
    - item: "\uB530\uB77C\uC11C \uB354 \uCD18\uCD18\uD558\uAC8C \uC794\uC0C1\uC774
        \uB098\uC635\uB2C8\uB2E4."
      subItems: []
  - item: "\uC2DC\uC791 \uC2DC \uACBD\uACE0 \uCD9C\uB825\uC774 \uB354\uC6B1 \uB180\uB77C\uC6B8
      \uC815\uB3C4\uB85C \uBE60\uB974\uAC8C \uC9C0\uB098\uAC11\uB2C8\uB2E4."
    subItems:
    - item: "\uB530\uB77C\uC11C \uB354 \uCD18\uCD18\uD558\uAC8C \uC794\uC0C1\uC774
        \uB098\uC635\uB2C8\uB2E4."
      subItems: []
  etc:
  - item: "\uC774\uC81C GitHub \uD398\uC774\uC9C0\uC758 CHANGELOG.md \uB294 \uC5C5\uB370\uC774\uD2B8\uD558\uC9C0
      \uC54A\uC744 \uAC83\uC785\uB2C8\uB2E4."
    subItems: []

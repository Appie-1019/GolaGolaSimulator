  m_Script: {fileID: 11500000, guid: f912db265f6164a4da2301e5fba69c49, type: 3}
  m_Name: GGS_1.5.1
  m_EditorClassIdentifier: Assembly-CSharp::VersionDataSO
  versionName: V1.5.1 (2026/8.12)
  developerComment: "\uB9C8\uC6B0\uC2A4\uB97C \uD314\uC774 \uBE60\uC9C8 \uB54C\uAE4C\uC9C0
    \uB3CC\uB824\uBCF4\uC138\uC694."
  additional:
  - item: "\uC774\uC81C GolaGola\uD560 \uB54C\uB9C8\uB2E4 \uC18C\uB9AC\uAC00 \uC788\uC2B5\uB2C8\uB2E4."
    subItems:
    - item: "\uAD00\uB828 \uC124\uC815\uB3C4 \uCD94\uAC00\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
      subItems: []
  - item: "\uD06C\uB808\uB527\uC5D0 \uC74C\uC545\uC774 \uCD94\uAC00\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    subItems: []
  changes:
  - item: "\uD06C\uB808\uB527 \uBC30\uC18D \uAE30\uB2A5\uC744 \uC774\uC6A9\uD558\uBA74
      \uC790\uC8FC \uBB38\uC790 \uC704\uCE58\uAC00 \uC5B4\uAE0B\uB098\uAC70\uB098
      \uACB9\uCE58\uB294 \uBB38\uC81C\uAC00 \uD574\uACB0\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    subItems: []
  - item: "\uC774\uC81C \uD06C\uB808\uB527 \uBC30\uC18D \uC548\uB0B4 \uBA54\uC2DC\uC9C0\uB294
      \uC591\uC2EC\uC788\uB294 \uD22C\uBA85\uB3C4\uB97C \uAC00\uC9D1\uB2C8\uB2E4."
    subItems: []
  - item: "\uD06C\uB808\uB527\uC774 \uB05D\uB098\uBA74 \uC774\uC81C \uBA54\uC778
      \uD654\uBA74\uC73C\uB85C \uB3CC\uC544\uAC11\uB2C8\uB2E4."
    subItems: []
  - item: "\uC2DC\uBBAC\uB808\uC774\uD130 \uC548\uACFC CHANGELOG.md\uC758 \uBC84\uC804
      \uC815\uBCF4\uAC00 \uC798\uBABB \uD45C\uAE30\uB41C \uBD80\uBD84\uC774 \uC218\uC815\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    subItems: []
  - item: "\uBC30\uACBD \uC124\uC815\uC758 HEX \uC785\uB825\uB780\uC774 \uBAA8\uB450
      \uB300\uBB38\uC790\uB85C \uBC14\uB00C\uC9C0 \uC54A\uB294 \uBB38\uC81C\uB97C
      \uD574\uACB0\uD588\uC2B5\uB2C8\uB2E4."
    subItems: []
  - item: "\uD06C\uB808\uB527\uC774 \uC694\uC18C\uAC00 \uCD94\uAC00\uB428\uC5D0 \uB530\uB77C
      \uBCC0\uACBD\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    subItems: []
  - item: "\uD06C\uB808\uB527\uC758 \uC77C\uBD80 \uAE00\uC790\uC5D0 \uC0C9\uC0C1\uC744
      \uCD94\uAC00\uD588\uC2B5\uB2C8\uB2E4."
    subItems: []
  etc:
  - item: "\uAC1C\uBC1C\uC790\uAC00 \uC9C4\uC9C0\uD558\uAC8C \uC778\uD2B8\uB85C\uC5D0
      \uC788\uB294 \uACBD\uACE0 \uBA54\uC2DC\uC9C0\uB97C \uC9E7\uAC8C \uB9CC\uB4E4\uC9C0
      \uB9D0\uC9C0 \uACE0\uBBFC\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    subItems:
    - item: "\uB9E8\uB0A0 \uD14C\uC2A4\uD2B8\uD560 \uB54C\uB9C8\uB2E4 10\uCD08\uB3D9\uC548
        \uACBD\uACE0 \uD654\uBA74\uC744 \uBCF4\uACE0 \uC788\uC790\uB2C8, \uC778\uC0DD\uC758
        \uC9C8\uC774 \uD558\uB77D\uD569\uB2C8\uB2E4."
      subItems: []
    - item: "\uACE0\uBBFC\uB9CC \uD588\uC2B5\uB2C8\uB2E4. \uC544\uC9C1 \uC544\uBB34\uAC83\uB3C4
        \uBC14\uAFB8\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
      subItems: []

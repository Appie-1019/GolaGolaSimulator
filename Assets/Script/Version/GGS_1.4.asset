  changes:
  - item: "CHANGELOG.md \uC758 \uBAA8\uB4E0 \uBC84\uC804 \uAE30\uB85D\uC5D0 [\uCD94\uAC00\uB428],
      [\uC218\uC815\uB428], [\uAE30\uD0C0] \uB97C \uAD6C\uBD84\uD588\uC2B5\uB2C8\uB2E4."
    subItems: []
  - item: "\uD1A0\uC2A4\uD2B8 \uBA54\uC2DC\uC9C0 \uC704\uCE58\uAC00 \uC57D\uAC04
      \uC544\uB798\uC5D0 \uD45C\uC2DC\uB418\uB3C4\uB85D \uC870\uC815\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    subItems: []
  - item: "\uC774\uC81C \uD29C\uD1A0\uB9AC\uC5BC\uC6A9 \uD1A0\uC2A4\uD2B8 \uBA54\uC2DC\uC9C0\uB294
      \uC0C9\uC0C1\uC774 \uC788\uC2B5\uB2C8\uB2E4."
    subItems: []
  - item: "\uD314\uACFC \uB2E4\uB9AC\uAC00 \uBAB8\uD1B5\uC744 \uBC14\uB77C\uBCF4\uB294
      \uAC01\uB3C4\uAC00 \uBBFF\uAE30\uC9C0 \uC54A\uC744 \uC815\uB3C4\uB85C \uC544\uC8FC
      \uC57D\uAC04 \uC870\uC815\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    subItems: []
  - item: "\uBA54\uB274\uC758 \uC2A4\uD06C\uB864 \uC18D\uB3C4\uB97C \uACFC\uB3C4\uD558\uAC8C
      \uB290\uB9AC\uC9C0 \uC54A\uB3C4\uB85D \uC870\uC815\uD588\uC2B5\uB2C8\uB2E4."
    subItems: []

  developerComment: "\uC774\uC81C \uB2E4\uC591\uD55C \uBC29\uBC95\uC73C\uB85C GolaGola\uD574\uBCF4\uC138\uC694."
  additional:
  - item: "\uBA54\uB274\uAC00 \uC774\uC81C \uB4DC\uB86D\uB2E4\uC6B4 \uBA54\uB274\uB85C
      \uAD6C\uC131\uB429\uB2C8\uB2E4. \uD3BC\uCE58\uACE0 \uC811\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    subItems: []
  - item: "\uC774\uC81C \uC870\uC791 \uBC29\uC2DD\uC744 \uBCC0\uACBD\uD560 \uC218
      \uC788\uB294 \uAE30\uB2A5\uC744 \uCD94\uAC00\uD588\uC2B5\uB2C8\uB2E4. \uD604\uC7AC
      \uC874\uC7AC\uD558\uB294 \uBAA8\uB4E0 \uC870\uC791 \uBC29\uC2DD\uC740 \uB2E4\uC74C\uACFC
      \uAC19\uC2B5\uB2C8\uB2E4."
    subItems:
    - item: "\uAE30\uBCF8"
      subItems: []
    - item: "\uAD00\uC131"
      subItems: []

  versionName: V1.2 (2026/7.8)
  developerComment: "\uB9E4\uC6B0 \uB611\uB531\uC5EC\uBCF4\uC138\uC694"
  additional:
  - item: "\uC774\uC81C \uBA54\uB274\uAC00 \uD0A4\uACE0 \uB04C \uB54C \uD398\uC774\uB4DC
      \uC778/\uC544\uC6C3 \uD6A8\uACFC\uAC00 \uC788\uC2B5\uB2C8\uB2E4."
    subItems: []
  - item: "\uD1A0\uAE00 \uC2A4\uC704\uCE58\uB85C \uB3D9\uC791\uD558\uB294 \uC0C8\uB85C\uC6B4
      \uC124\uC815\uC744 \uCD94\uAC00\uD588\uC2B5\uB2C8\uB2E4."
    subItems:
    - item: "\uC774\uC81C \uD1A0\uC2A4\uD2B8 \uBA54\uC2DC\uC9C0\uB97C \uD0A4\uACE0
        \uB04C \uC218 \uC788\uC2B5\uB2C8\uB2E4."
      subItems: []
  - item: "\uC7AC\uBBF8\uC788\uB294 \uC774\uC2A4\uD130 \uC5D0\uADF8\uAC00 \uD558\uB098
      \uCD94\uAC00\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    subItems:
    - item: "C#\uC5D0 \uB2A5\uC219\uD55C \uBD84\uB4E4\uC740 \uC18C\uC2A4 \uCF54\uB4DC\uB97C
        \uC77D\uC744 \uC904 \uC544\uC2DC\uB2C8, \uC27D\uAC8C \uCC3E\uC744 \uC218
        \uC788\uC744 \uAC81\uB2C8\uB2E4."
      subItems: []
  changes:
  - item: "\"\uC124\uC815\"\uC744 \"\uBA54\uB274\"\uB85C \uC774\uB984\uC744 \uBC14\uAFB8\uC5C8\uC2B5\uB2C8\uB2E4."
    subItems:
    - item: "\uC124\uC815\uC744 \uC81C\uC678\uD55C \uB2E4\uB978 \uAC83\uB4E4\uB3C4
        \uACE7 \uCD94\uAC00\uB420 \uAC83\uC785\uB2C8\uB2E4."
      subItems: []
  - item: "\uBA54\uB274\uC758 \uBC30\uACBD\uC0C9\uC740 \uC774\uC81C \uD68C\uC0C9\uC785\uB2C8\uB2E4."
    subItems: []
  etc: []

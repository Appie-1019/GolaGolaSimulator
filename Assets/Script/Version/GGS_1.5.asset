  m_Script: {fileID: 11500000, guid: f912db265f6164a4da2301e5fba69c49, type: 3}
  m_Name: GGS_1.5
  m_EditorClassIdentifier: Assembly-CSharp::VersionDataSO
  versionName: V1.5 (2026/8.8)
  developerComment: Yo tween! ready for earrape
  additional:
  - item: "\uC774\uC81C \uBC84\uD2BC, \uC2AC\uB77C\uC774\uB354, \uC2A4\uC704\uCE58
      UI\uC5D0 \uC7AC\uC0DD\uB418\uB294 \uC18C\uB9AC\uAC00 \uC788\uC2B5\uB2C8\uB2E4."
    subItems: []
  - item: "\uBCFC\uB968 \uC124\uC815\uC774 \uBA54\uB274\uC5D0 \uCD94\uAC00\uB429\uB2C8\uB2E4"
    subItems:
    - item: "\uBAA8\uBC14\uC77C\uC740 \uC774\uC6A9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.
        \uB300\uC2E0 \uAE30\uAE30 \uCE21\uBA74\uC758 \uBCFC\uB968 \uC870\uC808 \uBC84\uD2BC\uC744
        \uC774\uC6A9\uD574\uC57C \uD569\uB2C8\uB2E4."
      subItems: []
  - item: "\uC774\uC81C \uD1A0\uC2A4\uD2B8 \uBA54\uC2DC\uC9C0 \uD5C8\uC6A9 \uC5EC\uBD80\uC640
      \uBCFC\uB968 \uC124\uC815\uC740 \uC790\uB3D9\uC73C\uB85C \uC800\uC7A5\uB429\uB2C8\uB2E4."
    subItems: []
  - item: "\uC774\uC81C \uD1A0\uC2A4\uD2B8 \uBA54\uC2DC\uC9C0\uB97C \uCF1C\uACE0
      \uB04C \uB54C\uB9C8\uB2E4 \uD1A0\uC2A4\uD2B8 \uBA54\uC2DC\uC9C0\uB85C \uC548\uB0B4\uAC00
      \uB098\uC635\uB2C8\uB2E4."
    subItems: []
  - item: "\uC774\uC81C \uC2DC\uC791\uD560 \uB54C\uB9C8\uB2E4 \uC544\uBB34\uC9DD\uC5D0\uB3C4
      \uC4F8\uBAA8\uC5C6\uB294 \uACBD\uACE0 \uBB38\uAD6C\uB4E4\uC774 \uB098\uC635\uB2C8\uB2E4."
    subItems:
    - item: "\uB180\uB78D\uAC8C\uB3C4 \uAC74\uB108\uB6F8 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
      subItems: []
  - item: "\uBA54\uB274\uC5D0 \uBC84\uC804 \uC815\uBCF4\uB97C \uC5F4\uB78C\uD560
      \uC218 \uC788\uB294 \uBC84\uD2BC\uC774 \uC0DD\uACBC\uC2B5\uB2C8\uB2E4."
    subItems: []
  - item: "\uBA54\uB274\uC5D0 \uD06C\uB808\uB527\uC744 \uBCFC \uC218 \uC788\uB294
      \uBC84\uD2BC\uC744 \uCD94\uAC00\uD588\uC2B5\uB2C8\uB2E4."
    subItems:
    - item: "\uD06C\uB808\uB527 \uD654\uBA74\uC5D0\uC11C \uD654\uBA74\uC744 \uAE38\uAC8C
        \uB20C\uB7EC \uBE60\uB974\uAC8C \uB118\uAE38 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
      subItems: []
    - item: "\uD06C\uB808\uB527\uC744 \uB2E4 \uBCF4\uBA74 \uAC15\uC81C\uB85C \uADF8
        \uB054\uCC0D\uD55C \uACBD\uACE0 \uBB38\uAD6C\uB4E4\uC744 \uB2E4\uC2DC \uC2DC\uCCAD\uD574\uC57C
        \uD569\uB2C8\uB2E4."
      subItems: []
  - item: "'\uB6B1\uB6B1\uB0A8' \uC870\uC791 \uBC29\uC2DD\uC740 \uC774\uC81C \uCDA9\uB3CC\uD560
      \uB54C\uB9C8\uB2E4 \uC18C\uB9AC\uAC00 \uC788\uC2B5\uB2C8\uB2E4."
    subItems: []
  - item: "'\uC794\uC0C1' \uC870\uC791 \uBC29\uC2DD\uC774 \uCD94\uAC00\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    subItems: []
  - item: "\uC774\uC81C \uC790\uB3D9\uC73C\uB85C VSync(\uC218\uC9C1 \uB3D9\uAE30\uD654)\uD569\uB2C8\uB2E4."
    subItems:
    - item: "\uC6F9 \uBE0C\uB77C\uC6B0\uC800\uC758 \uC124\uC815\uC5D0 \uB530\uB77C
        \uB3D9\uC791\uD558\uC9C0 \uC54A\uC744 \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4."
      subItems: []
  changes:
  - item: "\uBA54\uB274 \uB514\uC790\uC778\uC774 \uBCC0\uACBD\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    subItems:
    - item: "\uB4DC\uB86D\uB2E4\uC6B4 \uBA54\uB274\uB294 \uC81C\uAC70\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
      subItems: []
  - item: "'\uC560\uD53C \uC2AC\uB77C\uC774\uB4DC'\uC758 3D \uBAA8\uB378\uC774 \uBBFF\uC744
      \uC218 \uC5C6\uC744 \uC815\uB3C4\uB85C \uC57D\uAC04 \uCD5C\uC801\uD654\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    subItems: []
  - item: "'\uB6B1\uB6B1\uB0A8' \uC870\uC791 \uBC29\uC2DD\uC5D0 \uC124\uBA85\uC774
      \uC5C6\uB358 \uBB38\uC81C\uB97C \uD574\uACB0\uD588\uC2B5\uB2C8\uB2E4."
    subItems: []
  etc: []

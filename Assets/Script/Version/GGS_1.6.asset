        subItems: []
    - item: "BackDoor : GolaGola \uBBA4\uC9C1\uC774 \uCD94\uAC00\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
      subItems:
      - item: "\uC5EC\uAE30\uC11C GolaGolaSimulator\uC5D0 \uC0AC\uC6A9\uB41C \uBAA8\uB4E0

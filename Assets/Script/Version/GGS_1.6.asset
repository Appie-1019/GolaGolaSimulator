    subItems: []
  - item: "\uC774\uC2A4\uD130\uC5D0\uADF8 2\uAC1C\uAC00 \uCD94\uAC00\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    subItems:
    - item: "\uC18C\uC2A4 \uCF54\uB4DC\uB97C \uCC3E\uC544\uBCF4\uC9C0 \uC54A\uB294
        \uC774\uC0C1, \uBC1C\uACAC\uD558\uAE30 \uC815\uB9D0 \uC5B4\uB824\uC6B8 \uAC81\uB2C8\uB2E4."
      subItems: []
  changes:
  - item: "\uD06C\uB808\uB527\uC5D0 Appie\uAC00 \uC544\uB2CC \uC0AC\uB78C\uB4E4\uC774

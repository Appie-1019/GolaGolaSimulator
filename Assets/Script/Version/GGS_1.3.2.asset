  m_Script: {fileID: 11500000, guid: f912db265f6164a4da2301e5fba69c49, type: 3}
  m_Name: GGS_1.3.2
  m_EditorClassIdentifier: Assembly-CSharp::VersionDataSO
  versionName: V1.3.2 (2026/7.9)
  developerComment: "\uC774 \uC9D3\uAC70\uB9AC\uB97C \uC5B4\uB514\uAE4C\uC9C0 \uD560
    \uC218 \uC788\uB098 \uC800\uB3C4 \uAD81\uAE08\uD558\uB124\uC694."
  additional:
  - item: "\uC774\uC81C \uBC30\uACBD \uC0C9\uC0C1\uC744 Hex \uCEEC\uB7EC \uCF54\uB4DC\uB85C
      \uC791\uC131\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    subItems: []
  changes:
  - item: "\uBAB8\uD1B5\uC758 \uC774\uB3D9 \uBC94\uC704\uC5D0 \uC81C\uD55C\uC774
      \uC0DD\uACBC\uC2B5\uB2C8\uB2E4."
    subItems: []
  - item: "\uBA54\uB274 \uD654\uBA74\uC758 \uC77C\uBD80 UI\uC758 \uD06C\uAE30\uB294
      \uBBFF\uAE30\uC9C0 \uC54A\uC744 \uC815\uB3C4\uB85C \uC544\uC8FC \uC57D\uAC04
      \uC870\uC815\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    subItems: []
  - item: "\uC774\uC81C \uC778\uD48B \uD544\uB4DC\uB294 \uC785\uB825\uC774 \uC644\uC804\uD788
      \uB05D\uB09C \uB4A4\uC5D0 \uC785\uB825\uC774 \uC720\uD6A8\uD55C\uC9C0 \uD310\uB2E8\uD558\uB3C4\uB85D
      \uBCC0\uACBD\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    subItems: []
  - item: "\uC5C5\uB370\uC774\uD2B8 V1.3\uC5D0\uC11C \uCD94\uAC00\uB418\uC5C8\uB358
      \uBAA8\uBC14\uC77C \uC804\uC6A9 \uAE30\uB2A5\uC778 \uBAB8\uD1B5\uC744 \uC911\uC559\uC73C\uB85C
      \uC62E\uAE30\uB294 \uAE30\uB2A5\uC740 \uC81C\uAC70\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    subItems: []
  - item: "\uC774\uC81C \uBAA8\uBC14\uC77C \uD658\uACBD\uC5D0\uC11C\uB3C4 \uBA54\uB274
      \uD654\uBA74\uC758 \uC0C1\uD558 \uC2A4\uD06C\uB864\uC774 \uC815\uC0C1\uC801\uC73C\uB85C
      \uAC00\uB2A5\uD569\uB2C8\uB2E4."
    subItems: []
  - item: "\uBAA8\uBC14\uC77C \uD658\uACBD\uC5D0\uC11C \uBA54\uB274 \uD654\uBA74\uC744
      \uC5EC\uB294 \uC870\uC791 \uBC29\uC2DD\uC774 \uBCC0\uACBD\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    subItems:
    - item: "\uAE30\uC874\uC758 \uB354\uBE14 \uD0ED \uBC29\uC2DD\uC5D0\uC11C, \uB450
        \uC190\uAC00\uB77D\uC73C\uB85C \uD654\uBA74\uC744 0.6887\uCD08 \uB3D9\uC548
        \uC720\uC9C0\uD558\uB294 \uBC29\uC2DD\uC73C\uB85C \uBCC0\uACBD\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
      subItems: []
  - item: "\uC870\uC791\uBC95 \uC219\uC9C0\uB97C \uB3D5\uAE30 \uC704\uD574 \uD29C\uD1A0\uB9AC\uC5BC\uC6A9
      \uD1A0\uC2A4\uD2B8 \uBA54\uC2DC\uC9C0\uC758 \uD14D\uC2A4\uD2B8 \uB0B4\uC6A9\uC774
      \uBCC0\uACBD\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    subItems: []
  - item: "\uC774\uC81C \uC5C5\uB370\uC774\uD2B8 \uB85C\uADF8\uB294 README.md\uAC00
      \uC544\uB2CC CHANGELOG.md\uC5D0 \uC788\uC2B5\uB2C8\uB2E4."
    subItems: []
  etc: []
